{
  "id": "one.zyx.pergola-local",
  "version": "1.3.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Pergola Local",
    "nl": "Pergola Lokaal"
  },
  "description": {
    "en": "Local network control for pergola and shading controllers. Works with Teleco Automation DaisyBox hardware (louvers, covers, lights, heaters). Pairing uses your Daisy account once to discover devices; all control is then fully offline over the box's local encrypted channel.",
    "nl": "Lokale netwerkbesturing voor pergola- en zonweringsbediening. Werkt met Teleco Automation DaisyBox-hardware (lamellen, zonwering, lampen, verwarming). Koppelen gebruikt eenmalig je Daisy-account om apparaten te vinden; daarna verloopt alle bediening volledig offline via het lokale versleutelde kanaal van de box."
  },
  "category": ["appliances"],
  "permissions": [],
  "brandColor": "#1f6f43",
  "author": {
    "name": "Ruslan Rusinov",
    "email": "ruslan.rusinov@live.de"
  },
  "source": "https://github.com/rrusinov/homey-pergola-local",
  "support": "mailto:ruslan.rusinov@live.de",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "capabilities": {
    "daisy_position": {
      "type": "enum",
      "title": {
        "en": "Position",
        "nl": "Positie"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "0",
          "title": { "en": "Closed (0%)", "nl": "Gesloten (0%)" }
        },
        {
          "id": "33",
          "title": { "en": "33%", "nl": "33%" }
        },
        {
          "id": "66",
          "title": { "en": "66%", "nl": "66%" }
        },
        {
          "id": "100",
          "title": { "en": "Open (100%)", "nl": "Open (100%)" }
        }
      ]
    }
  },
  "drivers": [
    {
      "id": "cover",
      "name": {
        "en": "Louver / Cover",
        "nl": "Lamellen / Zonwering"
      },
      "class": "windowcoverings",
      "platforms": ["local"],
      "connectivity": ["lan"],
      "capabilities": [
        "windowcoverings_state",
        "windowcoverings_set",
        "daisy_position"
      ],
      "images": {
        "small": "/drivers/cover/assets/images/small.png",
        "large": "/drivers/cover/assets/images/large.png"
      },
      "pair": [
        {
          "id": "login",
          "template": "login_credentials"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "light",
      "name": {
        "en": "Light / Heater",
        "nl": "Lamp / Verwarming"
      },
      "class": "light",
      "platforms": ["local"],
      "connectivity": ["lan"],
      "capabilities": [
        "onoff"
      ],
      "images": {
        "small": "/drivers/light/assets/images/small.png",
        "large": "/drivers/light/assets/images/large.png"
      },
      "pair": [
        {
          "id": "login",
          "template": "login_credentials"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    }
  ]
}
